{
  "name": "gaoyi-summer-transition",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node api/index.js",
    "dev": "node --watch api/index.js",
    "media:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-course-videos.ps1",
    "media:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-course-videos.ps1 -Upload",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1104.0",
    "@aws-sdk/s3-request-presigner": "3.1104.0",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  }
}
